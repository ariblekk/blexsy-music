<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, edge-to-edge shell. A white window background used to peek through
         the drawer's rounded corners because the page is offset to the right. -->
    <style name="Theme.Blexsy" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/blexsy_window_background</item>
        <item name="android:colorBackground">@color/blexsy_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
